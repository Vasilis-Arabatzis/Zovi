# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# uploaded product images (local dev storage)
/public/uploads

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Claude Code local settings (may contain credentials used in this session)
.claude/settings.local.json

# Third-party skill repos cloned for local Claude Code use, not project source
.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
