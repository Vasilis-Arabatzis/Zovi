generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SUPPLIER
  SUPER_ADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  AWAITING_FREIGHT_QUOTE
  FREIGHT_QUOTED
  IN_TRANSIT
  CANCELLED
  COMPLETED
  DISPUTED
}

enum ContractStatus {
  ACTIVE
  PAYMENT_DELINQUENT
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model Company {
  id           String        @id @default(cuid())
  legalName    String
  taxId        String        @unique
  country      String
  status       CompanyStatus @default(PENDING)
  address      String?
  activity     String?
  users        User[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(BUYER)
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  ordersAsBuyer     Order[]   @relation("BuyerOrders")
  ordersAsSupplier  Order[]   @relation("SupplierOrders")
  products          Product[] @relation("SupplierProducts")
  watchlist         ProductWatch[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  supplierId      String
  supplier        User        @relation("SupplierOrders", fields: [supplierId], references: [id])
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity        Int         @default(1)
  merchandiseCents Int
  freightCents     Int?
  status          OrderStatus @default(AWAITING_FREIGHT_QUOTE)
  escrowId        String?
  escrow          Escrow?     @relation(fields: [escrowId], references: [id])
  messages        ChatMessage[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Escrow {
  id            String   @id @default(cuid())
  vivaReference String   @unique
  heldCents     Int
  releasedCents Int      @default(0)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contract {
  id             String         @id @default(cuid())
  buyerId        String
  supplierId     String
  feeRateBps     Int
  status         ContractStatus @default(ACTIVE)
  nextBillingAt  DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Product {
  id           String        @id @default(cuid())
  supplierId   String
  supplier     User          @relation("SupplierProducts", fields: [supplierId], references: [id])
  name         String
  description  String
  sku          String        @unique
  priceCents   Int
  currency     String        @default("EUR")
  stockQty     Int           @default(0)
  category     String?
  imageUrl     String?
  status       ProductStatus @default(ACTIVE)
  watchedBy    ProductWatch[]
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProductWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  senderId   String
  rawContent String
  maskedContent String
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now())
}
